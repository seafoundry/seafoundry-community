{
    "name": "seafoundry-db-seeder",
    "version": "1.0.0",
    "description": "Database seeder for SeaFoundry app using Firebase Admin SDK",
    "main": "scripts/seed-demo.js",
    "scripts": {
        "seed:demo:community": "node scripts/seed-demo.js --tier=community",
        "seed:demo:pro": "node scripts/seed-demo.js --tier=pro",
        "seed:demo:scale": "node scripts/seed-demo.js --tier=scale",
        "seed:taxonomy": "ts-node --project tsconfig.scripts.json scripts/firestore/seed_taxonomy_data.ts",
        "seed:taxonomy:emulator": "FIRESTORE_EMULATOR_HOST=localhost:58080 ts-node --project tsconfig.scripts.json scripts/firestore/seed_taxonomy_data.ts",
        "fetch:taxonomy-images": "node scripts/fetch-taxonomy-images.js",
        "fetch:taxonomy-images:dry": "node scripts/fetch-taxonomy-images.js --dry-run",
        "upload:taxonomy-images": "node scripts/upload-taxonomy-images.js",
        "upload:taxonomy-images:thumbs": "node scripts/upload-taxonomy-images.js --generate-thumbs",
        "seed:training": "node scripts/seed-training.js",
        "setup": "node scripts/setup.js",
        "generate-models": "node scripts/generate-models.js",
        "generate-dart": "node scripts/generate-dart-models.js",
        "generate-all": "npm run generate-models && npm run generate-dart",
        "generate-dart-env": "node scripts/generate-dart-env.js",
        "sync:taxonomy-configs": "node scripts/sync_taxonomy_configs.js",
        "sync:taxonomy-configs:all-orgs": "node scripts/sync-taxonomy-configs-all-orgs.js",
        "sync:taxonomy-configs:firebase-cli": "./scripts/sync-taxonomy-configs-firebase-cli.sh",
        "conflicts:resolve": "flutter pub run scripts/conflicts/resolve_sync_conflict.dart",
        "overrides:download": "flutter pub run scripts/overrides/download_compliance_bundle.dart",
        "overrides:download:plan": "node scripts/overrides/run_compliance_bundle_plan.js",
        "podc:backfills": "node scripts/run_podc_backfills.js",
        "update-records": "node scripts/update-records.js",
        "remove-records": "node scripts/remove-records.js",
        "clear:community-posts": "node scripts/clear-community-posts.js",
        "clear:all": "node scripts/clear-all-data.js",
        "reset:deploy": "./scripts/reset-and-deploy.sh",
        "reset:deploy:dry": "./scripts/reset-and-deploy.sh --dry-run",
        "deploy:firestore": "firebase deploy --only firestore",
        "deploy:indexes": "firebase deploy --only firestore:indexes",
        "deploy:rules": "firebase deploy --only firestore:rules",
        "deploy:web": "./scripts/deploy-web.sh",
        "deploy:web:dry": "./scripts/deploy-web.sh --dry-run",
        "deploy:web:seed": "./scripts/deploy-web.sh --seed",
        "migrate:events": "node scripts/migrate-events-recordModelType.js",
        "migrate:createdEvent": "node scripts/migrate-createdEvent-recordModelType.js",
        "migrate:moveEvents": "node scripts/migrate-moveEvents-snapshotData.js",
        "migrate:deathEvents": "node scripts/migrate-death-to-population-loss.js",
        "normalize:provenanceid": "node scripts/normalize-provenanceid.js",
        "migrate:event-types": "node scripts/migrate_event_type_aliases.js",
        "migrate:event-organism-kind": "node scripts/backfill_event_metadata.js",
        "migrate:event-organism-kind:plan": "node scripts/migrations/run_event_metadata_backfill.js",
        "migrate:facility-enums": "ts-node --project tsconfig.scripts.json scripts/migrations/backfill_facility_enums.ts",
        "migrate:corals": "node scripts/migrate_corals_to_organisms.js",
        "export:inventory:plan": "node scripts/migrations/run_inventory_export_plan.js",
        "import:crc:dry-run": "node scripts/import-crc-historical.js --dry-run",
        "import:crc:execute": "node scripts/import-crc-historical.js --execute",
        "flutter:run": "./run.sh",
        "flutter:run:debug": "./run.sh --debug",
        "flutter:run:profile": "./run.sh --profile",
        "flutter:run:release": "./run.sh --release",
        "flutter:run:web": "flutter run -d chrome",
        "flutter:build:web": "npm run generate-dart-env && flutter build web --dart-define-from-file=dart_defines.json",
        "flutter:build:ios": "npm run generate-dart-env && flutter build ios --dart-define-from-file=dart_defines.json",
        "flutter:build:android": "npm run generate-dart-env && flutter build apk --dart-define-from-file=dart_defines.json",
        "emulator:start": "firebase emulators:start --only auth,firestore,storage",
        "emulator:start:ui": "firebase emulators:start --only auth,firestore,storage,ui",
        "emulator:kill": "firebase emulators:exec --only auth,firestore,storage 'echo Emulator stopped'",
        "seed:emulator": "FIRESTORE_EMULATOR_HOST=localhost:58080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 node scripts/seed-emulator.js",
        "test:integration": "flutter test integration_test/",
        "test:integration:full": "npm run emulator:start & sleep 5 && npm run seed:emulator && npm run test:integration; npm run emulator:kill",
        "test:smoke": "FIRESTORE_EMULATOR_HOST=localhost:58080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9555 node scripts/verify-permissions.js",
        "test:smoke:onboarding": "FIRESTORE_EMULATOR_HOST=localhost:58080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9555 node scripts/verify-permissions.js --category=onboarding",
        "test:smoke:taxonomy": "FIRESTORE_EMULATOR_HOST=localhost:58080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9555 node scripts/verify-permissions.js --category=taxonomy",
        "test:smoke:training": "FIRESTORE_EMULATOR_HOST=localhost:58080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9555 node scripts/verify-permissions.js --category=training",
        "test:smoke:storage": "FIRESTORE_EMULATOR_HOST=localhost:58080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9555 node scripts/verify-permissions.js --category=storage",
        "test:smoke:production": "GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json node scripts/verify-permissions.js --production",
        "postinstall": "node scripts/provision_java.js",
        "lint:tiers": "dart run tool/bin/tier_check.dart"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "firebase-admin": "^13.0.0",
        "js-yaml": "^4.1.1",
        "uuid": "^11.0.3"
    },
    "devDependencies": {
        "firebase": "^11.0.0",
        "json-schema-to-typescript": "^15.0.4",
        "nodemon": "^3.0.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.3"
    },
    "keywords": [
        "firebase",
        "firestore",
        "seeding",
        "database"
    ],
    "author": "SeaFoundry Team",
    "license": "MIT"
}
