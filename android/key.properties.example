## Release signing configuration for SeaFoundry Android builds.
## Copy this file to key.properties and fill in your values.
## key.properties is gitignored — never commit real credentials.
##
## Generate a keystore:
##   keytool -genkey -v \
##     -keystore seafoundry-release.keystore \
##     -alias seafoundry \
##     -keyalg RSA -keysize 2048 -validity 10000
##
## Store the keystore and passwords securely (e.g., 1Password, team vault).

storePassword=<your-keystore-password>
keyPassword=<your-key-password>
keyAlias=seafoundry
storeFile=<path-to>/seafoundry-release.keystore
