# SeaFoundry Environment Variables
# Copy this file to .env and fill in your actual values
#
# IMPORTANT: This .env file is the single source of truth for environment variables.
# The VS Code launch configurations and run.sh script will automatically load these values.
# After updating .env, run: node scripts/generate-dart-env.js

# Shake SDK API Key for crash reporting and bug tracking
# Get your API key from: https://app.shakebugs.com/
SHAKE_API_KEY=your_shake_api_key_here

# License Secret for signing organization license payloads
# REQUIRED in production builds. Used to validate license signatures for tier upgrades.
# Generate a secure random secret (e.g., openssl rand -base64 32)
# SF_LICENSE_SECRET=your_license_secret_here

# Logging Level
# Available values: verbose, debug, info, warning, error, critical
# If not set, defaults to 'debug' in debug mode, 'info' in release mode
# LOG_LEVEL=debug

# Firebase Configuration (optional - for local development)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_API_KEY=your_api_key

# Supabase Analytics Sync (optional)
# Set these to enable Supabase synchronization features in SyncManager.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role_key_or_anon_key
# SUPABASE_MAX_RETRIES=3

# Environment
# NODE_ENV=development
