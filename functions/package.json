{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:unit": "npm run build && mocha --require ts-node/register 'tests/**/*.test.ts'",
    "test": "firebase emulators:exec --only firestore --project demo-seafoundry \"npm run test:unit\"",
    "test:watch": "npm run build && mocha --require ts-node/register --watch --timeout 10000 'tests/**/*.test.ts'",
    "test:security": "jest --testPathPattern=security-rules --runInBand"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/src/index.js",
  "dependencies": {
    "@google-cloud/storage": "^7.17.3",
    "@google/generative-ai": "^0.24.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.0.5",
    "nodemailer": "^7.0.11",
    "resend": "^6.6.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/chai": "^4.3.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "chai": "^4.3.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.5.0",
    "json-schema-to-typescript": "^15.0.4",
    "mocha": "^10.2.0",
    "sinon": "^21.0.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "undici": "^7.2.0"
  },
  "private": true
}
