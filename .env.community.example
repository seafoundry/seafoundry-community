# SeaFoundry Community Edition Environment Variables
# Copy this file to .env and fill in your actual values
#
# IMPORTANT: This is for the Community (OSS) edition - Web only
# After updating .env, run: node scripts/generate-dart-env.js

# ========================================
# Build Configuration
# ========================================

# Tier setting - MUST be 'community' for OSS builds
TIER=community

# Enable demo mode for testing (false for production)
ENABLE_DEMO_MODE=false

# Logging Level
# Available values: verbose, debug, info, warning, error, critical
# Defaults to 'debug' in debug mode, 'info' in release mode
LOG_LEVEL=info

# Environment
NODE_ENV=production

# ========================================
# Firebase Configuration (REQUIRED)
# ========================================
# Get these values from your Firebase project settings
# Firebase Console -> Project Settings -> General -> Your apps -> Web app

# Firebase Project ID
FIREBASE_PROJECT_ID=your_project_id_here

# Firebase Web API Key
FIREBASE_API_KEY=your_api_key_here

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

# Firebase App ID (Web)
FIREBASE_APP_ID=your_app_id_here

# ========================================
# Web App Dart-Defines
# ========================================
# Public-facing URL prefix used when the app generates shareable links.
PUBLIC_URL_PREFIX=app.example.org/
# Comma-separated list of universal-link hosts the app should treat as its own.
# Example: app.example.org,www.example.org
DEEP_LINK_HOSTS=
# User-Agent for Wikipedia API lookups (per Wikimedia policy).
WIKIPEDIA_USER_AGENT=
# Public URLs for hosted legal documents. Used when LEGAL_USE_EXTERNAL_URLS=true.
LEGAL_TOS_URL=https://example.com/terms
LEGAL_PRIVACY_URL=https://example.com/privacy
LEGAL_SLA_URL=https://example.com/sla
