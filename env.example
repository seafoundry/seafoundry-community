# Firebase Configuration for SeaFoundry Development
# Copy this file to .env and fill in your actual values

# Required Firebase Configuration
FIREBASE_PROJECT_ID=seafoundryapp
FIREBASE_API_KEY=your_api_key_here
FIREBASE_APP_ID=your_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

# Optional Firebase Configuration (will use defaults if not provided)
FIREBASE_AUTH_DOMAIN=provenance.seafoundry.com
FIREBASE_STORAGE_BUCKET=seafoundryapp.firebasestorage.app
FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Crash Reporting (Shake)
# Get your API key from: https://app.shakebugs.com/
SHAKE_API_KEY=your_shake_api_key_here

# Demo Mode Configuration
DEMO_USER_EMAIL=community@provenance.app
DEMO_USER_PASSWORD=DemoPassword123!
DEMO_ORG_ID=demo_org_001

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual Firebase configuration
# 3. Get these values from your Firebase project settings
# 4. Run the app with: ./run.sh
