# Uncomment to opt out of anonymous analytics
# opt_out_usage

default_platform(:ios)

platform :ios do
  desc 'Build and upload to TestFlight (basic)'
  lane :beta do
    # Increment build number
    increment_build_number(xcodeproj: 'Runner.xcodeproj')

    # Build the app
    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: 'Runner',
      export_method: 'app-store',
      export_options: {
        provisioningProfiles: {
          'com.seafoundry.mobile' => 'SeaFoundry App Store Profile'
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      app_identifier: 'com.seafoundry.mobile',
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc 'Upload the already-exported IPA to TestFlight (internal testers)'
  lane :beta_internal_ipa do
    sh('pwd')
    root = File.expand_path('../..', __dir__) # repo root from ios/fastlane
    ipa_dir = File.join(root, 'build/ios/ipa')
    UI.user_error!("IPA directory not found at #{ipa_dir}") unless Dir.exist?(ipa_dir)
    ipa_path = File.join(ipa_dir, 'seafoundry_app.ipa')
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    # Prefer App Store Connect API key auth (no 2FA headaches)
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'], # e.g. ABCDE12345
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'], # the big UUID
      key_filepath: ENV['APP_STORE_CONNECT_API_KEY_PATH']
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      distribute_external: false # internal only
    )
  end

  desc 'Build Flutter app for iOS'
  lane :build_flutter do
    # --- Paths (run from ios/fastlane) ---
    root        = File.expand_path('../..', __dir__) # repo root from ios/fastlane
    ios_dir     = File.join(root, 'ios')
    export_plist = File.join(ios_dir, 'ExportOptions.plist')
    # --- Preconditions ---
    UI.user_error!("Missing ExportOptions.plist at #{export_plist}") unless File.exist?(export_plist)
    # Change to parent directory and build Flutter
    Dir.chdir(root) do
      sh('flutter clean')
      sh('flutter pub get')
      sh('pwd')
      sh("flutter build ipa --export-options-plist=#{export_plist}")
    end
  end

  desc 'Build (archive), export IPA via ExportOptions.plist, and upload to TestFlight (internal)'
  lane :beta_internal do |_options|
    UI.header 'SeaFoundry iOS beta_internal'

    # --- Paths (run from ios/fastlane) ---
    root = File.expand_path('../..', __dir__) # repo root from ios/fastlane
    ipa_path = File.join(root, 'build/ios/ipa/seafoundry_app.ipa')

    # Prefer App Store Connect API key auth (no 2FA headaches)
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'], # e.g. ABCDE12345
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'], # the big UUID
      key_filepath: ENV['APP_STORE_CONNECT_API_KEY_PATH']
    )

    # Increment build number
    # increment_build_number(xcodeproj: 'Runner.xcodeproj')

    # Build Flutter first
    build_flutter
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    # Upload to TestFlight for internal testing
    upload_to_testflight(
      ipa: ipa_path,
      api_key: api_key,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "Internal testing build - #{Time.now.strftime('%Y-%m-%d %H:%M')}"
    )

    notification(
      title: '🔵 Internal Build Ready',
      message: 'Build uploaded for internal testing'
    )
  end

  desc 'Deploy to external beta groups'
  lane :beta_external do |options|
    # Get groups from options or environment
    groups = options[:groups] || ENV['BETA_GROUPS'] || 'Beta Testers'
    groups = groups.split(',') if groups.is_a?(String)

    # Build Flutter first
    build_flutter

    # Increment build number
    increment_build_number(xcodeproj: 'Runner.xcodeproj')

    # Build the app
    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: 'Runner',
      export_method: 'app-store'
    )

    # Get changelog
    changelog = options[:changelog] || prompt(text: "What's new in this build?")

    # Upload to TestFlight with external distribution
    upload_to_testflight(
      app_identifier: 'com.seafoundry.mobile',
      skip_waiting_for_build_processing: false,
      skip_submission: false,
      distribute_external: true,
      groups: groups,
      notify_external_testers: options[:notify] != false,
      changelog: changelog,
      beta_app_review_info: {
        contact_email: ENV['BETA_REVIEW_EMAIL'] || ENV['APPLE_ID'],
        contact_first_name: ENV['BETA_REVIEW_FIRST_NAME'] || 'Beta',
        contact_last_name: ENV['BETA_REVIEW_LAST_NAME'] || 'Team',
        contact_phone: ENV['BETA_REVIEW_PHONE'] || '+1-555-555-5555',
        demo_account_name: ENV['BETA_DEMO_ACCOUNT'] || '',
        demo_account_password: ENV['BETA_DEMO_PASSWORD'] || '',
        notes: ENV['BETA_REVIEW_NOTES'] || 'Thank you for reviewing our app!'
      }
    )

    notification(
      title: '🚀 External Beta Deployed',
      message: "Build distributed to groups: #{groups.join(', ')}"
    )
  end

  desc 'Full TestFlight deployment pipeline'
  lane :deploy_testflight do
    # Build Flutter first
    build_flutter

    # Then build and deploy to TestFlight
    beta

    # Send notification
    notification(
      title: '🚀 SeaFoundry Deployed',
      message: 'Successfully uploaded new build to TestFlight'
    )
  end

  desc 'Build app for development'
  lane :dev do
    build_flutter

    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: 'Runner',
      export_method: 'development'
    )
  end

  desc 'Add tester to beta groups'
  lane :add_tester do |options|
    email = options[:email] || prompt(text: 'Enter tester email:')
    first_name = options[:first_name] || prompt(text: 'Enter first name:')
    last_name = options[:last_name] || prompt(text: 'Enter last name:')
    groups = options[:groups] || ENV['DEFAULT_BETA_GROUP'] || prompt(text: 'Enter groups (comma-separated):')

    groups = groups.split(',') if groups.is_a?(String)
    groups = groups.map(&:strip) # Remove whitespace

    UI.message("Adding #{first_name} #{last_name} (#{email}) to TestFlight groups: #{groups.join(', ')}")

    begin
      # Use pilot add command to actually add the tester
      # Note: pilot add expects groups as comma-separated string
      groups_string = groups.join(',')

      sh("bundle exec fastlane pilot add #{email} " \
         "-g \"#{groups_string}\" " \
         "--first_name \"#{first_name}\" " \
         "--last_name \"#{last_name}\" " \
         '--api_key_path api_key.json')

      UI.success("✅ Successfully added #{email} to TestFlight groups: #{groups.join(', ')}")

      # Store tester info for future reference
      tester_info = {
        email: email,
        first_name: first_name,
        last_name: last_name,
        groups: groups,
        added_at: Time.now.to_s,
        status: 'added'
      }

      # Save to a local file for record keeping
      require 'json'
      testers_log = File.join(File.dirname(__FILE__), 'testers_log.json')
      existing = File.exist?(testers_log) ? JSON.parse(File.read(testers_log)) : []
      existing << tester_info
      File.write(testers_log, JSON.pretty_generate(existing))

      UI.message("📝 Tester information logged to #{testers_log}")
    rescue StandardError => e
      UI.error("❌ Failed to add tester: #{e.message}")

      # Log the failure
      tester_info = {
        email: email,
        first_name: first_name,
        last_name: last_name,
        groups: groups,
        added_at: Time.now.to_s,
        status: 'failed',
        error: e.message
      }

      require 'json'
      testers_log = File.join(File.dirname(__FILE__), 'testers_log.json')
      existing = File.exist?(testers_log) ? JSON.parse(File.read(testers_log)) : []
      existing << tester_info
      File.write(testers_log, JSON.pretty_generate(existing))

      UI.message("📝 Failed attempt logged to #{testers_log}")
      raise e
    end
  end

  desc 'Remove tester from TestFlight'
  lane :remove_tester do |options|
    email = options[:email] || prompt(text: 'Enter tester email to remove:')

    UI.message('Note: To remove testers, you need to do it through App Store Connect')
    UI.message('Go to: App Store Connect > Your App > TestFlight > Testers')
    UI.message("Find #{email} and remove them from the appropriate groups")

    # NOTE: There's no direct API to remove testers via Fastlane
    # This would need to be done through App Store Connect web interface
  end

  desc 'List all testers'
  lane :list_testers do
    # Export testers to see the list
    output_file = 'fastlane/current_testers.csv'

    pilot(
      app_identifier: 'com.seafoundry.mobile',
      export_testers: output_file
    )

    # Read and display the CSV
    if File.exist?(output_file)
      require 'csv'
      UI.message('Current TestFlight Testers:')
      UI.message('-' * 50)
      CSV.foreach(output_file, headers: true) do |row|
        UI.message("#{row['Email']} - #{row['FirstName']} #{row['LastName']} (Groups: #{row['Groups']})")
      end
    end
  end

  desc 'Import testers from CSV'
  lane :import_testers do |options|
    csv_path = options[:csv] || 'fastlane/testers.csv'

    unless File.exist?(csv_path)
      UI.error("CSV file not found at #{csv_path}")
      UI.message('Create a CSV with format: FirstName,LastName,Email,Groups')
      UI.message('Groups should be semicolon-separated for multiple groups')
      return
    end

    # Use pilot to import testers from CSV
    pilot(
      app_identifier: 'com.seafoundry.mobile',
      testers_file_path: csv_path
    )

    UI.success("✅ Finished importing testers from #{csv_path}")
  end

  desc 'Export testers to CSV'
  lane :export_testers do |options|
    output_path = options[:output] || 'fastlane/exported_testers.csv'

    # Use pilot to export testers
    pilot(
      app_identifier: 'com.seafoundry.mobile',
      export_testers: output_path
    )

    UI.success("✅ Exported testers to #{output_path}")
  end

  desc 'Distribute existing build to groups'
  lane :distribute_build do |options|
    build_number = options[:build] || prompt(text: 'Enter build number to distribute:')
    groups = options[:groups] || prompt(text: 'Enter groups (comma-separated):')
    groups = groups.split(',') if groups.is_a?(String)

    upload_to_testflight(
      app_identifier: 'com.seafoundry.mobile',
      build_number: build_number.to_s,
      skip_submission: false,
      distribute_external: true,
      groups: groups,
      notify_external_testers: true,
      changelog: options[:changelog] || "Build #{build_number} is now available for testing"
    )

    UI.success("✅ Distributed build #{build_number} to groups: #{groups.join(', ')}")
  end

  error do |lane, exception|
    notification(
      title: '❌ Fastlane Error',
      message: "#{lane} failed: #{exception}"
    )
  end
end
