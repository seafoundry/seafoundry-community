# App Store Connect API Key Configuration
# Create these files at https://appstoreconnect.apple.com/access/integrations/api

# Method 1: Using API Key file (Recommended)
APP_STORE_CONNECT_API_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Method 2: Using API Key content (Alternative)
# APP_STORE_CONNECT_API_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEH..."

# Apple Developer Team ID
DEVELOPER_TEAM_ID=XXXXXXXXXX

# Apple ID (your developer account email)
APPLE_ID=your-email@example.com

# App identifier
APP_IDENTIFIER=com.seafoundry.mobile

# Provisioning profile name (optional - Fastlane can auto-generate)
PROVISIONING_PROFILE_NAME=SeaFoundry App Store Profile

# Beta Testing Configuration
# Default beta group for new testers
DEFAULT_BETA_GROUP=Beta Testers

# Multiple groups for external distribution (comma-separated)
BETA_GROUPS=Alpha Testers,Beta Testers

# Beta App Review Information (required for external distribution)
BETA_REVIEW_EMAIL=beta@seafoundry.com
BETA_REVIEW_FIRST_NAME=Beta
BETA_REVIEW_LAST_NAME=Team
BETA_REVIEW_PHONE=+1-555-555-5555

# Demo account for Apple reviewers (if your app requires login)
BETA_DEMO_ACCOUNT=demo@seafoundry.com
BETA_DEMO_PASSWORD=DemoPassword123!

# Notes for Apple reviewers
BETA_REVIEW_NOTES=Thank you for reviewing SeaFoundry! This app helps coral restoration organizations track and manage their coral colonies.