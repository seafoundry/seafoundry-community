rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function getUserOrgId() {
      return request.auth != null
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId
        : null;
    }

    function isMemberByUid(orgId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgCreatorOf(orgId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/organizations/$(orgId)) &&
        firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.createdById ==
          request.auth.uid;
    }

    // Single consolidated org membership check
    function isOrgMemberOf(orgId) {
      return request.auth != null &&
        (isMemberByUid(orgId) || getUserOrgId() == orgId || isOrgCreatorOf(orgId));
    }

    // Org branding uploads: allow any authenticated user (onboarding-friendly).
    match /organizations/{orgId}/images/brand/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Organization-scoped files: any org member can read AND write
    match /organizations/{orgId}/{allPaths=**} {
      allow read, write: if isOrgMemberOf(orgId);
    }

    // User-specific files: owner can read/write, any authenticated user can read
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public files
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Training media: any authenticated user
    match /training/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Outplant geometry KML files: org-scoped
    match /outplant_geometry/{orgId}/{allPaths=**} {
      allow read, write: if isOrgMemberOf(orgId);
    }

    // Shared taxonomy images: public read, server-only write
    match /shared/taxonomy/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Temporary uploads: scoped to user
    match /temp/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
